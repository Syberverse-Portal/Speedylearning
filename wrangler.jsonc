{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "speedylearning",
  "main": "./_worker.js",
  "compatibility_date": "2026-10-18",
  "build": {
    "command": "node scripts/build-static.mjs"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "VISIT_COUNTER",
        "class_name": "VisitCounter"
      }
    ]
  },
  "exports": {
    "VisitCounter": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "routes": [
    {
      "pattern": "speedylearning.co.uk",
      "custom_domain": true
    },
    {
      "pattern": "www.speedylearning.co.uk",
      "custom_domain": true
    }
  ],
  "workers_dev": true
}
