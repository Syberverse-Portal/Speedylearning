{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "speedylearning",
  "main": "./_worker.js",
  "compatibility_date": "2026-10-18",
  "build": {
    "command": "node scripts/build-static.mjs"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
